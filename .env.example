# Copy to .env (local) or paste into Streamlit Cloud > Settings > Secrets (as TOML: KEY = "value")
GEMINI_API_KEY=
# Supabase > Project Settings > Database > Connection string (Session pooler)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<project-ref>
DB_PASS=
DB_NAME=postgres
# Optional
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# ADMIN_PASSWORD=choose-something   (protects the Admin page)
